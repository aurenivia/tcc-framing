{
  "name": "leitor-enquadramento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Leitor de relatorios de enquadramento jornalistico (React)",
  "scripts": {
    "prepare-data": "node scripts/build-dataset.mjs",
    "dev": "npm run prepare-data && vite",
    "build": "npm run prepare-data && tsc --noEmit && vite build",
    "build:pages": "npm run prepare-data && tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "test": "npm run prepare-data && vitest run"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.0.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
